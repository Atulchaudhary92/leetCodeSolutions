class Solution {
public:
     int lastStoneWeightII(vector<int>& stones) {
        int n=stones.size();
        int sum=0;
        for(auto i: stones){
            sum+=i;
        }
        vector<bool>dp(sum/2+1,0);
        dp[0]=true;
        for(int i=0;i<stones.size();i++){
            for(int target=sum/2;target>=stones[i];target--){
                dp[target]=dp[target]||dp[target-stones[i]];
            }
        }
        int best=0;
        for(int i=sum/2;i>=0;i--){
            if(dp[i]){
               best=i;
               break;
            }
        }
        return sum-2*best;
     }
     };
