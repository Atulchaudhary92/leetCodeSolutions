class Solution {
public:
    int recursive(vector<string>&strs,int index,int m,int n,int x,vector<vector<vector<int>>>&dp){
        if(index==x) return 0;
        if(dp[index][m][n]!=-1) return dp[index][m][n];
        int zeros=0;
        int ones=0;
        for(char c : strs[index]){
            if(c=='0') zeros++;
            else ones++;
        }
        int take=0;
        if(m>=zeros && n>= ones){
            take=1+recursive(strs,index+1,m-zeros,n-ones,x,dp);
        }
        int notTake=recursive(strs,index+1,m,n,x,dp);
        return dp[index][m][n]=max(take,notTake);
    }
    int findMaxForm(vector<string>& strs, int m, int n) {
        vector<vector<int>> dp(m + 1, vector<int>(n + 1, 0));

for (string &s : strs) {

    int zeros = 0;
    int ones = 0;

    for (char c : s) {
        if (c == '0')
            zeros++;
        else
            ones++;
    }

    for (int z = m; z >= zeros; z--) {

        for (int o = n; o >= ones; o--) {

            dp[z][o] = max(
                dp[z][o],
                dp[z - zeros][o - ones] + 1
            );
        }
    }}
    return dp[m][n];
}
};
